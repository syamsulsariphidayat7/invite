[TEMPLATE]
# Postgres (Supabase via pooler Supavisor — port 6543, mode transaksi).
# Dashboard Supabase → Project Settings → Database → Connection string → Pooler.
# Tetap kompatibel dengan connection string Neon bila belum migrasi.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Untuk script migrasi Neon → Supabase (scripts/migrate-to-supabase.mjs):
# NEON_DATABASE_URL="postgresql://...neon.../neondb?sslmode=require"
# SUPABASE_DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres"

# Panel admin:
# ADMIN_PIN="482913"  # PIN login /admin (httpOnly cookie admin_pin; Vercel → Environment Variables)

# Supabase Storage (galeri admin):
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SECRET_KEY="<server-only, sb_secret_...>"  # atau SUPABASE_SERVICE_ROLE_KEY legacy; bucket invitation-photos/{slug}/
